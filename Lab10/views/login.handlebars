<h1>Login</h1>

{{#if error}}
  <p class="error">{{error}}</p>
{{/if}}

<form method="POST" action="/login" id="signin-form">
  <div>
    <label for="userId">User ID:</label>
    <input type="text" name="userId" id="userId" value="{{userId}}" required>
  </div>

  <div>
    <label for="password">Password:</label>
    <input type="password" name="password" id="password" required>
  </div>

  <button type="submit" name="submit_button" id="submit_button">Login</button>
</form>

<p>
  <a href="/register">Click here to signup!</a>
</p>
