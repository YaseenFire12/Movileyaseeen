<div id="superUserView">
  <p id="welcome">
    Welcome {{user.firstName}} {{user.lastName}}, the time is now: {{currentTime}} and the current date is {{currentDate}}. 
    You get super user access since you are a super user. Remember, with great power comes great responsibility!!
  </p>

  <p id="signupDate">The day you signed up was: {{user.signupDate}}</p>

  <p id="lastLogin">The last time you logged in was: {{user.lastLogin}}</p>

  <p id="quote">Favorite Quote: {{user.favoriteQuote}}</p>

  <a id="userLink" href="/user">User Page</a>

  <a id="signoutLink" href="/signout">Sign out</a>
</div>
